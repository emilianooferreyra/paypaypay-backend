generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  name        String?
  lastName    String?
  avatar      String?
  email       String  @unique
  backupEmail String?
  phone       String?
  password    String?
  country     String? @default("AR")
  language    String? @default("es-ES")

  emailConfirm       Boolean @default(false)
  backupEmailConfirm Boolean @default(false)
  phoneConfirm       Boolean @default(false)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  session       Session[]
  wallets       Wallet[]
  investments   Investment[]
  cards         Card[]
  beneficiaries Beneficiary[]
  kyc           KycVerification?
  portfolios    Portfolio[]

  status       UserStatusEnum   @default(ACTIVE)
  authProvider AuthProviderEnum @default(LOCAL)
  role         RoleEnum         @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

enum RoleEnum {
  CUSTOMER
  SUPPORT
  ADMIN
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken        String
  refreshTokenVersion Int    @default(0)

  userAgent String?
  ipAddress String?
  location  String?

  isActive Boolean @default(true)

  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userAgent])
  @@index([ipAddress])
}

enum UserStatusEnum {
  ACTIVE
  INACTIVE
  DRAFT
  BLOCKED
}

enum AuthProviderEnum {
  LOCAL
  GOOGLE
  FACEBOOK
  APPLE
}

model Wallet {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     WalletTypeEnum @default(USER)
  currency CurrencyEnum
  balance  Decimal        @default(0) @db.Decimal(20, 8)
  version  Int            @default(1)

  transactions         Transaction[] @relation("WalletTransactions")
  incomingTransactions Transaction[] @relation("WalletIncomingTransactions")
  ledgerEntries        LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
  @@index([userId])
  @@index([type, currency])
}

enum WalletTypeEnum {
  USER
  SYSTEM
}

model Transaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: Cascade)

  toWalletId String?
  toWallet   Wallet? @relation("WalletIncomingTransactions", fields: [toWalletId], references: [id])

  type     TransactionTypeEnum
  amount   Decimal               @db.Decimal(20, 8)
  currency CurrencyEnum
  status   TransactionStatusEnum @default(PENDING)

  description String?
  category    TransactionCategoryEnum?
  metadata    Json?

  reversesTransactionId String?      @unique
  reversesTransaction   Transaction? @relation("TransactionReversal", fields: [reversesTransactionId], references: [id])
  reversedByTransaction Transaction? @relation("TransactionReversal")

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([toWalletId])
  @@index([createdAt])
  @@index([type])
  @@index([status])
}

enum LedgerDirectionEnum {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id String @id @default(uuid())

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  direction LedgerDirectionEnum
  amount    Decimal             @db.Decimal(20, 8)
  currency  CurrencyEnum

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([transactionId])
}

model Asset {
  id     String        @id @default(uuid())
  symbol String        @unique
  name   String
  type   AssetTypeEnum

  currentPrice Decimal @db.Decimal(18, 2)
  dailyChange  Float   @default(0)
  logoUrl      String?

  investments Investment[]

  updatedAt DateTime @updatedAt

  @@index([symbol])
  @@index([type])
}

model Investment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  quantity     Decimal @db.Decimal(18, 8)
  avgBuyPrice  Decimal @db.Decimal(18, 2)
  currentValue Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, assetId])
  @@index([userId])
  @@index([assetId])
}

model Card {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          CardTypeEnum
  maskedNumber  String
  expiresAt     DateTime
  network       String?
  issuer        String?
  cardToken     String?
  isActive      Boolean      @default(true)
  isFrozen      Boolean      @default(false)
  spendingLimit Decimal?     @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ExchangeRate {
  id           String       @id @default(uuid())
  fromCurrency CurrencyEnum
  toCurrency   CurrencyEnum
  rate         Decimal      @db.Decimal(18, 6)
  date         DateTime     @default(now())

  @@index([fromCurrency, toCurrency])
  @@index([date])
}

model KycVerification {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       KycStatusEnum @default(PENDING)
  documentType String?
  submittedAt  DateTime?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum CurrencyEnum {
  ARS
  USD
  USDT
  BRL
}

enum TransactionTypeEnum {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  EXCHANGE
  YIELD
  INVESTMENT_BUY
  INVESTMENT_SELL
  REVERSAL
}

enum TransactionStatusEnum {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum TransactionCategoryEnum {
  FOOD
  TRANSPORT
  ENTERTAINMENT
  HEALTH
  UTILITIES
  SHOPPING
  INVESTMENT
  TRANSFER
  OTHER
}

enum AssetTypeEnum {
  STOCK
  ETF
  COMMODITY
  CRYPTO
  BOND
  CEDEAR
  FCI
}

enum VisibilityEnum {
  PUBLIC
  PRIVATE
}

enum CardTypeEnum {
  INTERNATIONAL
  LOCAL
}

enum KycStatusEnum {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

model Portfolio {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  visibility  VisibilityEnum @default(PRIVATE)

  assets PortfolioAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PortfolioAsset {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  symbol      String
  type        AssetTypeEnum
  quantity    Decimal       @db.Decimal(18, 8)
  avgBuyPrice Decimal       @db.Decimal(18, 2)
  currency    String        @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([symbol])
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  url       String
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String          @id @default(uuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  payload        String
  status         String          @default("pending")
  attempts       Int             @default(0)
  responseStatus Int?
  nextRetryAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Outbox link. Null only on rows written before the outbox existed.
  eventId     String?
  outboxEvent OutboxEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Lease held by the worker that claimed this delivery; expires on its own.
  lockedUntil DateTime?
  lastError   String?

  @@unique([eventId, endpointId])
  @@index([endpointId, createdAt])
  @@index([status, nextRetryAt])
}

// A fact that happened, written in the same transaction as the change that
// caused it. Delivery state lives in WebhookDelivery, one row per endpoint.
model OutboxEvent {
  id            String    @id @default(uuid())
  // Assigned at insert time. Together with the per-wallet advisory lock taken
  // on enqueue, it follows commit order for events of the same wallet, which
  // createdAt (the transaction start) does not.
  seq           BigInt    @default(autoincrement())
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime  @default(now())
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  deliveries WebhookDelivery[]

  @@index([processedAt, seq])
  @@index([aggregateType, aggregateId])
}

enum BeneficiaryTypeEnum {
  CBU
  CVU
  ALIAS
  SWIFT
  ACCOUNT_NUMBER
}

model Beneficiary {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  alias           String
  beneficiaryType BeneficiaryTypeEnum
  accountNumber   String
  bankName        String?
  currency        CurrencyEnum
  country         String              @default("AR")
  documentType    String?
  documentNumber  String?
  isActive        Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, currency])
}

enum IdempotencyStatusEnum {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model IdempotencyRecord {
  id          String                @id @default(uuid())
  key         String
  userId      String
  route       String
  status      IdempotencyStatusEnum @default(IN_PROGRESS)
  response    Json?
  statusCode  Int?
  requestHash String?
  lockToken   String?
  lockedUntil DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([userId, key])
  @@index([createdAt])
}

enum ReconciliationStatusEnum {
  OK
  DISCREPANCY
}

model ReconciliationReport {
  id      String                   @id @default(uuid())
  runAt   DateTime                 @default(now())
  status  ReconciliationStatusEnum
  details Json

  @@index([runAt])
}

model UserBackupCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, code])
  @@index([userId])
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?

  action   String
  entity   String
  entityId String

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Broker {
  id   String @id @default(uuid())
  slug String @unique
  name String

  feeBuyPct  Decimal  @db.Decimal(6, 3)
  feeSellPct Decimal  @db.Decimal(6, 3)
  feeMaxPct  Decimal? @db.Decimal(6, 3)
  feeMinArs  Decimal? @db.Decimal(12, 2)
  ivaOnFees  Boolean  @default(true)

  subscriptionMonthlyArs Decimal? @db.Decimal(12, 2)
  subscriptionNotes      String?

  custodyPctAnnual     Decimal? @db.Decimal(6, 3)
  custodyMinMonthlyArs Decimal? @db.Decimal(12, 2)
  custodyNotes         String?

  feeNotes       String?
  sources        Json
  lastVerifiedAt DateTime
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}
